<template>
	<view class="page">
		<text class="title">tui-svg-uasm SVG 渲染测试</text>
		<text class="text">对 /static/tui-test.svg 依次执行 getInfo / render / renderSize，并展示渲染结果。</text>

		<button class="btn" :disabled="running" @click="runTest">运行测试</button>

		<view class="step" v-for="(item, i) in steps" :key="i">
			<text class="step-name">{{ item.name }}</text>
			<text :class="item.ok ? 'step-ok' : 'step-pending'">{{ item.detail }}</text>
			<image v-if="item.src.length > 0" :src="item.src" class="step-img" mode="aspectFit"></image>
		</view>

		<text class="summary" v-if="summary.length > 0">{{ summary }}</text>
		<text class="error" v-if="errorMessage.length > 0">{{ errorMessage }}</text>
	</view>
</template>

<script setup lang="uts">
	import { getInfo, render, renderSize } from '@/uni_modules/tui-svg-uasm'

	type Step = {
		name : string,
		ok : boolean,
		detail : string,
		src : string
	}

	const steps = ref<Step[]>([])
	const summary = ref("")
	const errorMessage = ref("")
	const running = ref(false)

	function writeBytesToTemp(name : string, bytes : Uint8Array) : Promise<string> {
		return new Promise<string>((resolve, reject) => {
			const filePath = uni.env.USER_DATA_PATH + '/tui-svg-' + name + '.png'
			uni.getFileSystemManager().writeFile({
				filePath: filePath,
				data: bytes.buffer as ArrayBuffer,
				success: () => {
					resolve(filePath)
				},
				fail: (err) => {
					reject(new Error('tui-svg: write temp failed: ' + err.errMsg))
				}
			})
		})
	}

	// 渲染结果字节 → 可展示的图片 src：Web 用 Blob URL，App/小程序写临时文件
	async function bytesToSrc(bytes : Uint8Array, name : string) : Promise<string> {
		// #ifdef WEB
		const blob = new Blob([bytes.buffer as ArrayBuffer], { type: 'image/png' })
		return URL.createObjectURL(blob)
		// #endif
		// #ifndef WEB
		return writeBytesToTemp(name, bytes)
		// #endif
	}

	async function addStep(name : string, ok : boolean, detail : string, bytes ?: Uint8Array) {
		let src = ''
		if (ok && bytes != null) {
			try {
				src = await bytesToSrc(bytes, name)
			} catch (e) {
				console.log(e)
			}
		}
		const list = steps.value
		list.push({ name: name, ok: ok, detail: detail, src: src } as Step)
		steps.value = list
	}

	async function runTest() {
		errorMessage.value = ""
		summary.value = ""
		steps.value = []
		running.value = true
		try {
			const path = '/static/tui-test.svg'

			// 1. getInfo（固定宽高）
			const info = await getInfo(path)
			addStep('getInfo', info.width > 0 && info.height > 0, info.width + 'x' + info.height)

			// 2. render 原始尺寸
			const r1 = await render(path)
			addStep('render 1x', r1.length > 0, '输出 ' + r1.length + ' B (png)', r1)

			// 3. render 2x 放大
			const r2 = await render(path, 2)
			addStep('render 2x', r2.length > 0, '输出 ' + r2.length + ' B (png)', r2)

			// 4. renderSize 指定宽度（等比）
			const r3 = await renderSize(path, 320, 0)
			addStep('renderSize 320xauto', r3.length > 0, '输出 ' + r3.length + ' B (png)', r3)

			// 5. renderSize 精确尺寸
			const r4 = await renderSize(path, 96, 96)
			addStep('renderSize 96x96', r4.length > 0, '输出 ' + r4.length + ' B (png)', r4)

			const list = steps.value
			let allPass = true
			for (let i = 0; i < list.length; i++) {
				if (!list[i].ok) {
					allPass = false
				}
			}
			if (allPass) {
				summary.value = '✓ 全部 ' + list.length + ' 项通过'
			} else {
				errorMessage.value = '存在失败项，请查看控制台日志'
			}
		} catch (e) {
			console.log(e)
			errorMessage.value = '测试异常中断，请查看控制台日志'
		}
		running.value = false
	}
</script>

<style>
	.page {
		padding: 15px;
		display: flex;
		flex-direction: column;
	}

	.title {
		font-size: 18px;
		font-weight: bold;
		margin-bottom: 10px;
	}

	.text {
		font-size: 13px;
		line-height: 20px;
		margin-bottom: 6px;
		color: #666666;
	}

	.btn {
		margin-top: 12px;
	}

	.step {
		margin-top: 12px;
		padding: 10px;
		border-radius: 6px;
		background-color: #F5F6F8;
		display: flex;
		flex-direction: column;
	}

	.step-name {
		font-size: 14px;
		font-weight: bold;
		margin-bottom: 4px;
	}

	.step-ok {
		font-size: 12px;
		color: #34C759;
	}

	.step-pending {
		font-size: 12px;
		color: #FF3B30;
	}

	.step-img {
		margin-top: 8px;
		width: 240px;
		height: 160px;
		border-radius: 6px;
		background-color: #ECEEF2;
	}

	.summary {
		margin-top: 15px;
		font-size: 14px;
		font-weight: bold;
		color: #34C759;
	}

	.error {
		margin-top: 15px;
		font-size: 13px;
		color: #FF3B30;
	}
</style>
