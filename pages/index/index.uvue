<template>
	<view class="page">
		<text class="title">tui-color-thief-uasm 主色提取测试</text>
		<text class="text">提取 /static/logo.png 的主色、四边颜色与调色板。</text>

		<button class="btn" @click="testColorThief">提取图片主色（tui-color-thief）</button>

		<view class="color-row" v-if="dominantHex.length > 0">
			<view class="color-block color-block-large" :style="'background-color: ' + dominantHex"></view>
		</view>

		<view class="color-row" v-if="edgeColors.length > 0">
			<view v-for="(item, i) in edgeColors" :key="i" class="color-block" :style="'background-color: ' + item"></view>
		</view>

		<view class="color-row" v-if="paletteColors.length > 0">
			<view v-for="(item, i) in paletteColors" :key="i" class="color-block color-block-small" :style="'background-color: ' + item"></view>
		</view>

		<text class="error">{{ errorMessage }}</text>

		<text class="section-title">tui-zip-uasm 压缩解压测试</text>
		<text class="text">内存往返：zip 创建/列表/读取（含中文文件名）+ gzip 压缩解压。</text>

		<button class="btn" @click="testZip">运行 zip 测试（tui-zip）</button>

		<text class="result" v-if="zipResult.length > 0">{{ zipResult }}</text>
		<text class="error">{{ zipError }}</text>
	</view>
</template>

<script setup lang="uts">
	import { getPalette, rgbToHex } from '@/uni_modules/tui-color-thief-uasm'
	import { zipCreate, zipList, zipReadEntry, gzipCompress, gzipDecompress } from '@/uni_modules/tui-zip-uasm'

	const dominantHex = ref("")
	const edgeColors = ref<string[]>([])
	const paletteColors = ref<string[]>([])
	const errorMessage = ref("")
	const zipResult = ref("")
	const zipError = ref("")

	function strToBytes(s: string): Uint8Array {
		const arr = new Uint8Array(s.length)
		for (let i = 0; i < s.length; i++) {
			arr[i] = s.charCodeAt(i) & 0xFF
		}
		return arr
	}

	function bytesEqual(a: Uint8Array, b: Uint8Array): boolean {
		if (a.length != b.length) {
			return false
		}
		for (let i = 0; i < a.length; i++) {
			if (a[i] != b[i]) {
				return false
			}
		}
		return true
	}

	async function testColorThief() {
		errorMessage.value = ""
		try {
			const res = await getPalette('/static/logo.png', 6)
			// const res = await getPalette('https://yundie.xyz/static/template/20260620/e21c0311c60646e242926b11c91bbc1e.jpg', 6)
			dominantHex.value = rgbToHex(res.dominant)

			const edges = [] as string[]
			for (let i = 0; i < res.edges.length; i++) {
				edges.push(rgbToHex(res.edges[i]))
			}
			edgeColors.value = edges

			const palette = [] as string[]
			for (let i = 0; i < res.palette.length; i++) {
				palette.push(rgbToHex(res.palette[i]))
			}
			paletteColors.value = palette
		} catch (e) {
			console.log(e)
			dominantHex.value = ""
			edgeColors.value = []
			paletteColors.value = []
			errorMessage.value = "主色提取失败，请查看控制台日志"
		}
	}
	async function testZip() {
		zipError.value = ""
		zipResult.value = ""
		try {
			// 1. zip 创建：中文文件名 + JSON 文本
			const text = '你好，tui-zip！Hello zip!'
			const json = '{"msg":"second entry"}'
			const zipBytes = await zipCreate(
				['中文文件.txt', 'data.json'],
				[strToBytes(text), strToBytes(json)]
			)

			// 2. zip 列表
			const names = await zipList(zipBytes)
			const namesStr = JSON.stringify(names)

			// 3. zip 读取：内容逐字节比对
			const back = await zipReadEntry(zipBytes, '中文文件.txt')
			const readOk = bytesEqual(back, strToBytes(text))

			// 4. gzip 往返：压缩自身 zip 数据再解压比对
			const gz = await gzipCompress(zipBytes, 9)
			const ungz = await gzipDecompress(gz)
			const gzipOk = bytesEqual(ungz, zipBytes)

			if (!readOk || !gzipOk) {
				zipError.value = '内容比对失败 readOk=' + readOk + ' gzipOk=' + gzipOk
				return
			}
			zipResult.value = '✓ 通过 | entries=' + namesStr
				+ ' | zip=' + zipBytes.length + 'B'
				+ ' | gzip=' + gz.length + 'B (原 ' + zipBytes.length + 'B)'
		} catch (e) {
			console.log(e)
			zipResult.value = ""
			zipError.value = 'zip 测试失败，请查看控制台日志'
		}
	}
</script>

<style>
	.page {
		padding: 15px;
		display: flex;
		flex-direction: column;
	}

	.title {
		font-size: 18px;
		font-weight: bold;
		margin-bottom: 10px;
	}

	.text {
		font-size: 13px;
		line-height: 20px;
		margin-bottom: 6px;
		color: #666666;
	}

	.btn {
		margin-top: 12px;
	}

	.color-row {
		margin-top: 15px;
		display: flex;
		flex-direction: row;
	}

	.color-block {
		width: 48px;
		height: 48px;
		border-radius: 6px;
		margin-right: 8px;
	}

	.color-block-large {
		width: 96px;
		height: 96px;
		border-radius: 12px;
	}

	.color-block-small {
		width: 40px;
		height: 40px;
	}

	.section-title {
		margin-top: 30px;
		font-size: 16px;
		font-weight: bold;
		margin-bottom: 10px;
	}

	.result {
		margin-top: 12px;
		font-size: 13px;
		color: #007AFF;
	}
</style>
