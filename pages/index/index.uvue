<template>
	<view class="page">
		<text class="title">tui-color-thief-uasm 主色提取测试</text>
		<text class="text">提取 /static/logo.png 的主色、四边颜色与调色板。</text>

		<button class="btn" @click="testColorThief">提取图片主色（tui-color-thief）</button>

		<view class="color-row" v-if="dominantHex.length > 0">
			<view class="color-block color-block-large" :style="'background-color: ' + dominantHex"></view>
		</view>

		<view class="color-row" v-if="edgeColors.length > 0">
			<view v-for="(item, i) in edgeColors" :key="i" class="color-block" :style="'background-color: ' + item"></view>
		</view>

		<view class="color-row" v-if="paletteColors.length > 0">
			<view v-for="(item, i) in paletteColors" :key="i" class="color-block color-block-small" :style="'background-color: ' + item"></view>
		</view>

		<text class="error">{{ errorMessage }}</text>

		<button class="btn" @click="goZipTest">zip 压缩解压测试（tui-zip）→</button>
		<button class="btn" @click="goImageTest">图片处理测试（tui-image）→</button>
	</view>
</template>

<script setup lang="uts">
	import { getPalette, rgbToHex } from '@/uni_modules/tui-color-thief-uasm'

	const dominantHex = ref("")
	const edgeColors = ref<string[]>([])
	const paletteColors = ref<string[]>([])
	const errorMessage = ref("")

	function goZipTest() {
		uni.navigateTo({ url: '/pages/zip/zip' })
	}

	function goImageTest() {
		uni.navigateTo({ url: '/pages/image/image' })
	}

	async function testColorThief() {
		errorMessage.value = ""
		try {
			const res = await getPalette('/static/logo.png', 6)
			// const res = await getPalette('https://yundie.xyz/static/template/20260620/e21c0311c60646e242926b11c91bbc1e.jpg', 6)
			dominantHex.value = rgbToHex(res.dominant)

			const edges = [] as string[]
			for (let i = 0; i < res.edges.length; i++) {
				edges.push(rgbToHex(res.edges[i]))
			}
			edgeColors.value = edges

			const palette = [] as string[]
			for (let i = 0; i < res.palette.length; i++) {
				palette.push(rgbToHex(res.palette[i]))
			}
			paletteColors.value = palette
		} catch (e) {
			console.log(e)
			dominantHex.value = ""
			edgeColors.value = []
			paletteColors.value = []
			errorMessage.value = "主色提取失败，请查看控制台日志"
		}
	}
</script>

<style>
	.page {
		padding: 15px;
		display: flex;
		flex-direction: column;
	}

	.title {
		font-size: 18px;
		font-weight: bold;
		margin-bottom: 10px;
	}

	.text {
		font-size: 13px;
		line-height: 20px;
		margin-bottom: 6px;
		color: #666666;
	}

	.btn {
		margin-top: 12px;
	}

	.color-row {
		margin-top: 15px;
		display: flex;
		flex-direction: row;
	}

	.color-block {
		width: 48px;
		height: 48px;
		border-radius: 6px;
		margin-right: 8px;
	}

	.color-block-large {
		width: 96px;
		height: 96px;
		border-radius: 12px;
	}

	.color-block-small {
		width: 40px;
		height: 40px;
	}
</style>
