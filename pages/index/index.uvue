<template>
	<view class="page">
		<text class="title">tui-color-thief-uasm 主色提取测试</text>
		<text class="text">提取 /static/logo.png 的主色、四边颜色与调色板。</text>

		<button class="btn" @click="testColorThief">提取图片主色（tui-color-thief）</button>

		<text class="result">{{ paletteText }}</text>
		<text class="error">{{ errorMessage }}</text>
	</view>
</template>

<script setup lang="uts">
	import { getPalette, rgbToHex } from '@/uni_modules/tui-color-thief-uasm'

	const paletteText = ref("")
	const errorMessage = ref("")

	async function testColorThief() {
		errorMessage.value = ""
		try {
			const res = await getPalette('/static/logo.png', 6)
			let text = "主色: " + rgbToHex(res.dominant)
			text += "  尺寸: " + res.width + "x" + res.height
			text += "\n四边: "
			const names = ["上", "右", "下", "左"]
			for (let i = 0; i < res.edges.length; i++) {
				text += names[i] + "=" + rgbToHex(res.edges[i]) + " "
			}
			text += "\n调色板: "
			for (let i = 0; i < res.palette.length; i++) {
				text += rgbToHex(res.palette[i]) + " "
			}
			paletteText.value = text
		} catch (e) {
			console.log(e)
			paletteText.value = ""
			errorMessage.value = "主色提取失败，请查看控制台日志"
		}
	}
</script>

<style>
	.page {
		padding: 15px;
		display: flex;
		flex-direction: column;
	}

	.title {
		font-size: 18px;
		font-weight: bold;
		margin-bottom: 10px;
	}

	.text {
		font-size: 13px;
		line-height: 20px;
		margin-bottom: 6px;
		color: #666666;
	}

	.btn {
		margin-top: 12px;
	}

	.result {
		margin-top: 20px;
		font-size: 15px;
		color: #007aff;
	}

	.error {
		margin-top: 20px;
		font-size: 15px;
		color: #ff0000;
	}
</style>
