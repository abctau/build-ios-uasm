<template>
	<view class="page">
		<text class="title">tui-xlsx-uasm Excel 读写测试</text>
		<text class="text">多 sheet 生成（string/number/bool/null）+ 解析往返，逐项校验。</text>

		<button class="btn" :disabled="running" @click="runTest">运行测试</button>

		<view class="step" v-for="(item, i) in steps" :key="i">
			<text class="step-name">{{ item.name }}</text>
			<text :class="item.ok ? 'step-ok' : 'step-pending'">{{ item.detail }}</text>
		</view>

		<text class="summary" v-if="summary.length > 0">{{ summary }}</text>
		<text class="error" v-if="errorMessage.length > 0">{{ errorMessage }}</text>
	</view>
</template>

<script setup lang="uts">
	import { writeXlsx, readXlsx } from '@/uni_modules/tui-xlsx-uasm'
	import { XlsxSheet } from '@/uni_modules/tui-xlsx-uasm/utssdk/interface.uts'

	type Step = {
		name : string,
		ok : boolean,
		detail : string
	}

	const steps = ref<Step[]>([])
	const summary = ref("")
	const errorMessage = ref("")
	const running = ref(false)

	function addStep(name : string, ok : boolean, detail : string) {
		const list = steps.value
		list.push({ name: name, ok: ok, detail: detail } as Step)
		steps.value = list
	}

	async function runTest() {
		errorMessage.value = ""
		summary.value = ""
		steps.value = []
		running.value = true
		try {
			// 1. 生成两个 sheet（多类型值 + 中文 + 特殊字符）
			const text = '中文 & <tag> "q" \n行2'
			const s1 = { name: '成绩表', rows: [['姓名', '分数', '及格'], ['小明', 92.5, true], ['小红', 58, false]] } as XlsxSheet
			const s2 = { name: '备注', rows: [[null, text], [45123, null]] } as XlsxSheet
			const bytes = await writeXlsx([s1, s2])
			addStep('writeXlsx', bytes.length > 0 && bytes[0] == 0x50, '输出 ' + bytes.length + ' B (zip)')

			// 2. 解析往返：sheet 数与名称
			const wb = await readXlsx(bytes)
			addStep('解析 sheet 结构', wb.sheets.length == 2 && wb.sheets[0].name == '成绩表',
				'sheets=' + wb.sheets.length + ' [' + wb.sheets[0].name + ', ' + wb.sheets[1].name + ']')

			// 3. 往返值校验：字符串/数字/布尔/null
			const r1 = wb.sheets[0].rows[1]
			const okValues = r1[0] == '小明' && r1[1] == 92.5 && r1[2] == true &&
				wb.sheets[0].rows[2][1] == 58 && wb.sheets[0].rows[2][2] == false
			addStep('往返值校验', okValues, JSON.stringify(r1))

			// 4. 特殊字符与 null 洞往返
			const r2 = wb.sheets[1].rows[0]
			addStep('特殊字符/null', r2[0] == null && r2[1] == text && wb.sheets[1].rows[1][0] == 45123,
				'hole=' + (r2[0] == null) + ', text保留=' + (r2[1] == text))

			// 5. 错误输入拒绝：空 sheets
			let rejected = false
			try {
				await writeXlsx([])
			} catch (e) {
				rejected = true
			}
			addStep('空 sheets 拒绝', rejected, 'rejected=' + rejected)

			const list = steps.value
			let allPass = true
			for (let i = 0; i < list.length; i++) {
				if (!list[i].ok) {
					allPass = false
				}
			}
			if (allPass) {
				summary.value = '✓ 全部 ' + list.length + ' 项通过'
			} else {
				errorMessage.value = '存在失败项，请查看控制台日志'
			}
		} catch (e) {
			console.log(e)
			errorMessage.value = '测试异常中断，请查看控制台日志'
		}
		running.value = false
	}
</script>

<style>
	.page {
		padding: 15px;
		display: flex;
		flex-direction: column;
	}

	.title {
		font-size: 18px;
		font-weight: bold;
		margin-bottom: 10px;
	}

	.text {
		font-size: 13px;
		line-height: 20px;
		margin-bottom: 6px;
		color: #666666;
	}

	.btn {
		margin-top: 12px;
	}

	.step {
		margin-top: 12px;
		padding: 10px;
		border-radius: 6px;
		background-color: #F5F6F8;
		display: flex;
		flex-direction: column;
	}

	.step-name {
		font-size: 14px;
		font-weight: bold;
		margin-bottom: 4px;
	}

	.step-ok {
		font-size: 12px;
		color: #34C759;
	}

	.step-pending {
		font-size: 12px;
		color: #FF3B30;
	}

	.summary {
		margin-top: 15px;
		font-size: 14px;
		font-weight: bold;
		color: #34C759;
	}

	.error {
		margin-top: 15px;
		font-size: 13px;
		color: #FF3B30;
	}
</style>
