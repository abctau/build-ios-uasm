<template>
	<view class="page">
		<text class="title">tui-ffmpeg-uasm 媒体解析/抽帧/转码测试</text>
		<text class="text">getMediaInfo + extractFrame + B 方案转码（videoCrop/clip/speed/compress/effect/PiP），逐项校验。</text>

		<button class="btn" :disabled="running" @click="runTest">运行解析测试</button>
		<button class="btn" :disabled="running" @click="runTranscodeTest" v-if="hasTranscode">运行转码测试（B 方案）</button>

		<view class="step" v-for="(item, i) in steps" :key="i">
			<text class="step-name">{{ item.name }}</text>
			<text :class="item.ok ? 'step-ok' : 'step-pending'">{{ item.detail }}</text>
		</view>

		<image class="frame" v-if="frame1.length > 0" :src="frame1Src" mode="aspectFit" />
		<image class="frame" v-if="frame2.length > 0" :src="frame2Src" mode="aspectFit" />

		<text class="summary" v-if="summary.length > 0">{{ summary }}</text>
		<text class="error" v-if="errorMessage.length > 0">{{ errorMessage }}</text>
	</view>
</template>

<script setup lang="uts">
	import { getMediaInfo, extractFrame, videoCrop, durationClip, videoSpeed, videoCompress, videoEffect, videoPictureInPicture, audioMerge } from '@/uni_modules/tui-ffmpeg-uasm'

	type Step = {
		name : string,
		ok : boolean,
		detail : string
	}

	const steps = ref<Step[]>([])
	const summary = ref("")
	const errorMessage = ref("")
	const running = ref(false)
	const frame1 = ref<Uint8Array>(new Uint8Array(0))
	const frame2 = ref<Uint8Array>(new Uint8Array(0))
	const frame1Src = ref("")
	const frame2Src = ref("")
	// #ifndef MP-WEIXIN || MP-ALIPAY
	const hasTranscode = ref(true)
	// #endif
	// #ifdef MP-WEIXIN || MP-ALIPAY
	const hasTranscode = ref(false)
	// #endif

	function addStep(name : string, ok : boolean, detail : string) {
		const list = steps.value
		list.push({ name: name, ok: ok, detail: detail } as Step)
		steps.value = list
	}

	function bytesToSrc(bytes : Uint8Array) : string {
		// #ifdef WEB
		const blob = new Blob([bytes as any], { type: 'image/png' })
		return URL.createObjectURL(blob)
		// #endif
		// #ifndef WEB
		const path = uni.env.USER_DATA_PATH + '/ffmpeg-frame-' + Date.now() + '.png'
		uni.getFileSystemManager().writeFile(path, bytes as any, 'binary')
		return path
		// #endif
	}

	function outPath(name : string) : string {
		return uni.env.USER_DATA_PATH + '/ff-' + name + '-' + Date.now() + '.mp4'
	}

	async function probeOut(path : string, label : string) {
		const info = await getMediaInfo(path)
		const v = info.streams.find((s) : boolean => s.type == 'video')
		let sizeDesc = ''
		if (v != null) {
			sizeDesc = ' ' + v.width + 'x' + v.height
		}
		addStep(label, true,
			'durationMs=' + info.durationMs + sizeDesc + ' streams=' + info.streams.length)
	}

	// #ifdef WEB
	// Web 端：URL 进 → 返回 Uint8Array；用 Blob objectURL 走 getMediaInfo 校验
	async function webProbe(bytes : Uint8Array, label : string) {
		const url = URL.createObjectURL(new Blob([bytes as any], { type: 'video/mp4' }))
		const info = await getMediaInfo(url)
		const v = info.streams.find((s) : boolean => s.type == 'video')
		let sizeDesc = ''
		if (v != null) {
			sizeDesc = ' ' + v.width + 'x' + v.height
		}
		addStep(label, true, 'durationMs=' + info.durationMs + sizeDesc + ' streams=' + info.streams.length)
		return url
	}

	async function runTranscodeTestWeb() {
		errorMessage.value = ""
		summary.value = ""
		steps.value = []
		running.value = true
		try {
			// 1. videoCrop
			const u1 = await webProbe(await videoCrop('/static/test-video.mp4', 0, 0, 640, 480), 'videoCrop 640x480')

			// 2. durationClip
			const u2 = await webProbe(await durationClip('/static/test-video.mp4', 0, 3000), 'durationClip')
			const info2 = await getMediaInfo(u2)
			addStep('durationClip 3s', info2.durationMs > 1500 && info2.durationMs <= 4500,
				'durationMs=' + info2.durationMs)

			// 3. videoSpeed 1.5x
			const u3 = await webProbe(await videoSpeed('/static/test-video.mp4', 1.5), 'videoSpeed 1.5x')
			const info3 = await getMediaInfo(u3)
			addStep('videoSpeed 1.5x 时长', info3.durationMs > 5000 && info3.durationMs < 8000,
				'durationMs=' + info3.durationMs)

			// 4. videoCompress
			const u4 = await webProbe(await videoCompress('/static/test-video.mp4', 640, 360, 800), 'videoCompress 640x360')
			const info4 = await getMediaInfo(u4)
			const v4 = info4.streams.find((s) : boolean => s.type == 'video')
			addStep('videoCompress 尺寸', v4 != null && v4.width == 640 && v4.height == 360,
				'size=' + (v4 != null ? (v4.width.toString() + 'x' + v4.height.toString()) : 'null'))

			// 5. videoEffect 黑白
			await webProbe(await videoEffect('/static/test-video.mp4', 'grayscale'), 'videoEffect grayscale')

			// 6. audioMerge 混音
			const u6 = await webProbe(await audioMerge('/static/test-video.mp4', '/static/test-video.mp4'), 'audioMerge')
			const info6 = await getMediaInfo(u6)
			addStep('audioMerge 流数', info6.streams.length >= 1, 'streams=' + info6.streams.length)

			// 7. PiP
			await webProbe(await videoPictureInPicture('/static/test-video.mp4', '/static/test-video.mp4', 20, 20, 320, 180), 'videoPictureInPicture 320x180@20,20')

			// 8. 转码产物抽帧
			const png = await extractFrame(u4, 2000, 160)
			addStep('转码产物抽帧', png.length > 300, 'PNG ' + png.length + ' B')

			const list = steps.value
			let allPass = true
			for (let i = 0; i < list.length; i++) {
				if (!list[i].ok) {
					allPass = false
				}
			}
			if (allPass) {
				summary.value = '✓ 转码全部 ' + list.length + ' 项通过'
			} else {
				errorMessage.value = '存在失败项，请查看控制台日志'
			}
		} catch (e) {
			console.log(e)
			errorMessage.value = '转码测试异常中断：' + (e instanceof Error ? e.message : e.toString())
		}
		running.value = false
	}
	// #endif

	// #ifndef WEB
	async function runTranscodeTestNonWeb() {
		errorMessage.value = ""
		summary.value = ""
		steps.value = []
		running.value = true
		try {
			// 1. videoCrop 裁剪画面（重编码）
			const p1 = outPath('crop')
			await videoCrop('/static/test-video.mp4', 0, 0, 640, 480, p1)
			await probeOut(p1, 'videoCrop 640x480')

			// 2. durationClip 裁 3 秒（copy）
			const p2 = outPath('clip')
			await durationClip('/static/test-video.mp4', 0, 3000, p2)
			const info2 = await getMediaInfo(p2)
			addStep('durationClip 3s', info2.durationMs > 1500 && info2.durationMs <= 4500,
				'durationMs=' + info2.durationMs)

			// 3. videoSpeed 1.5x
			const p3 = outPath('speed')
			await videoSpeed('/static/test-video.mp4', 1.5, p3)
			const info3 = await getMediaInfo(p3)
			addStep('videoSpeed 1.5x', info3.durationMs > 5000 && info3.durationMs < 8000,
				'durationMs=' + info3.durationMs)

			// 4. videoCompress 缩放 + 码率
			const p4 = outPath('compress')
			await videoCompress('/static/test-video.mp4', 640, 360, 800, p4)
			const info4 = await getMediaInfo(p4)
			const v4 = info4.streams.find((s) : boolean => s.type == 'video')
			addStep('videoCompress 640x360', v4 != null && v4.width == 640 && v4.height == 360,
				'size=' + (v4 != null ? (v4.width.toString() + 'x' + v4.height.toString()) : 'null'))

			// 5. videoEffect 黑白
			const p5 = outPath('effect')
			await videoEffect('/static/test-video.mp4', 'grayscale', p5)
			await probeOut(p5, 'videoEffect grayscale')

			// 6. audioMerge 双轨混音
			const p6 = outPath('amix')
			await audioMerge('/static/test-video.mp4', '/static/test-video.mp4', p6)
			const info6 = await getMediaInfo(p6)
			addStep('audioMerge', info6.streams.length >= 1, 'streams=' + info6.streams.length)

			// 7. videoPictureInPicture 画中画
			const p7 = outPath('pip')
			await videoPictureInPicture('/static/test-video.mp4', '/static/test-video.mp4', 20, 20, 320, 180, p7)
			await probeOut(p7, 'videoPictureInPicture 320x180@20,20')

			// 8. 转码产物再抽帧
			const png = await extractFrame(p4, 2000, 160)
			addStep('转码产物抽帧', png.length > 300, 'PNG ' + png.length + ' B')

			const list = steps.value
			let allPass = true
			for (let i = 0; i < list.length; i++) {
				if (!list[i].ok) {
					allPass = false
				}
			}
			if (allPass) {
				summary.value = '✓ 转码全部 ' + list.length + ' 项通过'
			} else {
				errorMessage.value = '存在失败项，请查看控制台日志'
			}
		} catch (e) {
			console.log(e)
			errorMessage.value = '转码测试异常中断：' + (e instanceof Error ? e.message : e.toString())
		}
		running.value = false
	}
	// #endif

	async function runTranscodeTest() {
		// #ifdef WEB
		await runTranscodeTestWeb()
		// #endif
		// #ifndef WEB
		await runTranscodeTestNonWeb()
		// #endif
	}

	async function runTest() {
		errorMessage.value = ""
		summary.value = ""
		steps.value = []
		running.value = true
		try {
			// 1. 媒体信息解析
			const info = await getMediaInfo('/static/test-video.mp4')
			const video = info.streams.find((s) : boolean => s.type == 'video')
			const okInfo = video != null && video.width == 1280 && video.height == 720 &&
				info.durationMs > 9000 && info.durationMs < 12000 && info.streams.length == 2
			addStep('getMediaInfo', okInfo,
				'container=' + info.container + ' durationMs=' + info.durationMs + ' streams=' + info.streams.length)

			// 2. 首帧抽帧（原始尺寸）
			const png1 = await extractFrame('/static/test-video.mp4', 0, 0)
			const magicOk = png1.length > 1000 && png1[0] == 0x89 && png1[1] == 0x50 && png1[2] == 0x4e && png1[3] == 0x47
			addStep('extractFrame 首帧', magicOk, 'PNG ' + png1.length + ' B (1280x720)')
			if (magicOk) {
				frame1.value = png1
				frame1Src.value = bytesToSrc(png1)
			}

			// 3. 中段抽帧 + 缩放 320 宽
			const png2 = await extractFrame('/static/test-video.mp4', 5000, 320)
			const w = (png2[16] << 24) | (png2[17] << 16) | (png2[18] << 8) | png2[19]
			const h = (png2[20] << 24) | (png2[21] << 16) | (png2[22] << 8) | png2[23]
			const okScale = png2.length > 500 && w == 320 && h == 180
			addStep('extractFrame t=5s 缩放', okScale, 'PNG ' + png2.length + ' B (' + w + 'x' + h + ')')
			if (okScale) {
				frame2.value = png2
				frame2Src.value = bytesToSrc(png2)
			}

			// 4. 尾段 seek 边界
			const png3 = await extractFrame('/static/test-video.mp4', 9900, 160)
			addStep('extractFrame t=9.9s', png3.length > 300, 'PNG ' + png3.length + ' B')

			// 5. 错误拒绝：垃圾字节
			let rejected = false
			try {
				await extractFrame('/static/logo.png', 0, 0)
			} catch (e) {
				rejected = true
			}
			addStep('垃圾输入拒绝', rejected, 'rejected=' + rejected)

			const list = steps.value
			let allPass = true
			for (let i = 0; i < list.length; i++) {
				if (!list[i].ok) {
					allPass = false
				}
			}
			if (allPass) {
				summary.value = '✓ 全部 ' + list.length + ' 项通过'
			} else {
				errorMessage.value = '存在失败项，请查看控制台日志'
			}
		} catch (e) {
			console.log(e)
			errorMessage.value = '测试异常中断，请查看控制台日志'
		}
		running.value = false
	}
</script>

<style>
	.page {
		padding: 15px;
		display: flex;
		flex-direction: column;
	}

	.title {
		font-size: 18px;
		font-weight: bold;
		margin-bottom: 10px;
	}

	.text {
		font-size: 13px;
		line-height: 20px;
		margin-bottom: 6px;
		color: #666666;
	}

	.btn {
		margin-top: 12px;
	}

	.step {
		margin-top: 12px;
		padding: 10px;
		border-radius: 6px;
		background-color: #F5F6F8;
		display: flex;
		flex-direction: column;
	}

	.step-name {
		font-size: 14px;
		font-weight: bold;
		margin-bottom: 4px;
	}

	.step-ok {
		font-size: 12px;
		color: #34C759;
	}

	.step-pending {
		font-size: 12px;
		color: #FF3B30;
	}

	.frame {
		margin-top: 12px;
		width: 320px;
		height: 180px;
	}

	.summary {
		margin-top: 15px;
		font-size: 14px;
		font-weight: bold;
		color: #34C759;
	}

	.error {
		margin-top: 15px;
		font-size: 13px;
		color: #FF3B30;
	}
</style>
