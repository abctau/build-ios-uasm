/**
 * tui-yoga 布局引擎（UASM）。树常驻 C 侧，增量操作 + 批量布局结果。
 * Web 端实现：wasm 加载是异步的（必须先 await init()），之后全部 API 同步调用。
 */

let lib : any = null

/**
 * 异步加载 wasm。调用任何业务函数前必须先 await 本函数一次。
 */
export async function init() : Promise<void> {
	if (lib == null) {
		lib = await uni.loadUasm('uni_modules/tui-yoga-uasm')
	}
}

function getLib() : any {
	if (lib == null) {
		throw new Error('tui-yoga: not initialized; call await init() first')
	}
	return lib as any
}

/** 创建布局节点，返回节点 id */
export function createNode() : number {
	return getLib().createNode() as number
}

/** 释放单个节点（自动与父节点断开） */
export function freeNode(nodeId : number) : boolean {
	return getLib().freeNode(nodeId) as boolean
}

/** 递归释放整棵子树（含自身） */
export function freeTree(rootId : number) : boolean {
	return getLib().freeTree(rootId) as boolean
}

/** 挂载子节点；index 省略时追加到末尾 */
export function insertChild(parentId : number, childId : number, index ? : number) : boolean {
	const m = getLib()
	if (index == null) {
		return m.insertChild(parentId, childId) as boolean
	}
	return m.insertChildAt(parentId, childId, index) as boolean
}

/** 从父节点移除子节点（不释放） */
export function removeChild(parentId : number, childId : number) : boolean {
	return getLib().removeChild(parentId, childId) as boolean
}

/**
 * 注册样式表（编译期用）：JSON → styleId。
 * 注册一次可应用到任意多个节点。
 */
export function registerStyle(propsJson : string) : number {
	return getLib().registerStyle(propsJson) as number
}

/** 把注册的样式整包应用到节点 */
export function applyStyle(nodeId : number, styleId : number) : boolean {
	return getLib().applyStyle(nodeId, styleId) as boolean
}

/** 单属性微更新：value 为 "12px" / "50%" / "auto" / 枚举字符串 */
export function setStyle(nodeId : number, key : string, value : string) : boolean {
	return getLib().setStyle(nodeId, key, value) as boolean
}

/** 单属性微更新（点值快捷方式） */
export function setStyleNum(nodeId : number, key : string, value : number) : boolean {
	return getLib().setStyleNum(nodeId, key, value) as boolean
}

/** 文本预测量：叶子节点（如文本）尺寸由调用方测量后传入 */
export function setMeasuredSize(nodeId : number, width : number, height : number) : boolean {
	return getLib().setMeasuredSize(nodeId, width, height) as boolean
}

/**
 * 以 rootId 为根计算布局（一次跨桥）。
 * availWidth/availHeight 为根节点可用空间；direction：0 = LTR，1 = RTL。
 */
export function calculateLayout(rootId : number, availWidth : number, availHeight : number, direction ? : number) : boolean {
	const m = getLib()
	if (direction == null) {
		return m.calculateLayout(rootId, availWidth, availHeight, 0) as boolean
	}
	return m.calculateLayout(rootId, availWidth, availHeight, direction) as boolean
}

/**
 * 收集整棵树的布局结果（一次跨桥）。
 * 返回扁平数组 [nodeId, x, y, width, height, ...]（前序遍历，含根节点）。
 */
export function collectFrames(rootId : number) : number[] {
	return getLib().collectFrames(rootId) as number[]
}

/** 读取单节点布局结果 [nodeId, x, y, width, height] */
export function getFrame(nodeId : number) : number[] {
	return getLib().getFrame(nodeId) as number[]
}

/** 节点或其子树是否有待重新布局的脏标记 */
export function isDirty(nodeId : number) : boolean {
	return getLib().isDirty(nodeId) as boolean
}
