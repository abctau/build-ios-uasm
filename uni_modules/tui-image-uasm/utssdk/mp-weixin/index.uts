import { type ImageInfoResult, type ImagePaletteResult } from '../interface.uts'

/**
 * App/小程序端实现：网络图先 downloadFile，再读文件二进制，交给 UASM 模块处理。
 */


function downloadToTemp(url: string): Promise<string> {
	return new Promise<string>((resolve, reject) => {
		uni.downloadFile({
			url: url,
			success: (res) => {
				if (res.statusCode == 200) {
					resolve(res.tempFilePath)
				} else {
					reject(new Error('tui-image: download failed ' + res.statusCode + ' for ' + url))
				}
			},
			fail: (err) => {
				reject(new Error('tui-image: download failed: ' + err.errMsg))
			}
		})
	})
}

function readLocalBytes(filePath: string): Promise<ArrayBuffer> {
	return new Promise<ArrayBuffer>((resolve, reject) => {
		uni.getFileSystemManager().readFile({
			filePath: filePath,
			success: (res) => {
				resolve(res.data as ArrayBuffer)
			},
			fail: (err) => {
				reject(new Error('tui-image: read failed: ' + err.errMsg))
			}
		})
	})
}

async function readImageBytes(path: string): Promise<Uint8Array> {
	let localPath = path
	if (path.startsWith('http://') || path.startsWith('https://')) {
		localPath = await downloadToTemp(path)
	}
	const data = await readLocalBytes(localPath)
	return new Uint8Array(data)
}

export async function getInfo(path: string): Promise<ImageInfoResult> {
	if (path.length == 0) {
		throw new Error('tui-image: path is empty')
	}
	const bytes = await readImageBytes(path)
	try {
		const lib = await uni.loadUasm('uni_modules/tui-image-uasm')
		return lib.getInfo(bytes) as ImageInfoResult
	} catch (e) {
		console.log(e)
		throw new Error('tui-image: getInfo failed')
	}
}

export async function resize(path: string, width: number, height: number, format?: string, quality?: number): Promise<Uint8Array> {
	if (path.length == 0) {
		throw new Error('tui-image: path is empty')
	}
	let fmt = 'png'
	let q = 85
	if (format != null) {
		fmt = format
	}
	if (quality != null) {
		q = quality
	}
	const bytes = await readImageBytes(path)
	try {
		const lib = await uni.loadUasm('uni_modules/tui-image-uasm')
		return lib.resize(bytes, width, height, fmt, q) as Uint8Array
	} catch (e) {
		console.log(e)
		throw new Error('tui-image: resize failed')
	}
}

