}

export async function composite(path: string, overlayPath: string, x: number, y: number, alpha?: number, format?: string, quality?: number): Promise<Uint8Array> {
	if (path.length == 0 || overlayPath.length == 0) {
		throw new Error('tui-image: path is empty')
	}
	let a = 100
	if (alpha != null) {
		a = alpha
	}
	let fmt = 'png'
	let q = 85
	if (format != null) {
		fmt = format
	}
	if (quality != null) {
		q = quality
	}
	const bytes = await readImageBytes(path)
	const overlayBytes = await readImageBytes(overlayPath)
	try {
		const lib = await uni.loadUasm('uni_modules/tui-image-uasm')
		return lib.composite(bytes, overlayBytes, x, y, a, fmt, q) as Uint8Array
	} catch (e) {
		console.log(e)
		throw new Error('tui-image: composite failed')
	}
}

/**
 * [r, g, b] 转 '#rrggbb'
 */
export function rgbToHex(color: number[]): string {
	if (color.length < 3) {
		return '#000000'
	}
	return '#' + toHexPart(color[0]) + toHexPart(color[1]) + toHexPart(color[2])
}

function toHexPart(value: number): string {
	let v = Math.round(value)
	if (v < 0) v = 0
	if (v > 255) v = 255
	const digits = "0123456789ABCDEF"
	const hi = Math.floor(v / 16)
	const lo = v % 16
	return digits.substring(hi, hi + 1) + digits.substring(lo, lo + 1)
}
