/**
 * position 解析为原图中心比例：number = 沿扩展方向的像素位置；
 * string = 百分比（'50%'）或像素（'50'）；缺省居中。
 */
function parsePosition(position: string | number | null, targetSize: number): number {
	if (position == null) {
		return 0.5
	}
	if (typeof position == 'number') {
		if (targetSize <= 0) {
			return 0.5
		}
		return position / targetSize
	}
	const s = position as string
	let value = NaN
	if (s.endsWith('%')) {
		value = parseFloat(s.substring(0, s.length - 1))
		if (!isNaN(value)) {
			return value / 100
		}
	} else {
		value = parseFloat(s)
		if (!isNaN(value)) {
			if (targetSize <= 0) {
				return 0.5
			}
			return value / targetSize
		}
	}
	return 0.5
}

export async function extendFill(path: string, targetWidth: number, targetHeight: number, direction?: string, position?: string | number, fill?: string, blurRadius?: number, format?: string, quality?: number): Promise<Uint8Array> {
	if (path.length == 0) {
		throw new Error('tui-image: path is empty')
	}
	let dir = 'vertical'
	if (direction != null) {
		dir = direction
	}
	let mode = 'blur'
	if (fill != null) {
		mode = fill
	}
	let radius = 24
	if (blurRadius != null) {
		radius = blurRadius
	}
	let fmt = 'png'
	let q = 85
	if (format != null) {
		fmt = format
	}
	if (quality != null) {
		q = quality
	}
	const targetSize = dir == 'horizontal' ? targetWidth : targetHeight
	const ratio = parsePosition(position, targetSize)
	const bytes = await readImageBytes(path)
	try {
		const lib = await uni.loadUasm('uni_modules/tui-image-uasm')
		return lib.extendFill(bytes, targetWidth, targetHeight, dir, ratio, mode, radius, fmt, q) as Uint8Array
	} catch (e) {
		console.log(e)
		throw new Error('tui-image: extendFill failed')
	}
}

export async function edgeBlur(path: string, radius: number, direction?: string, regions?: number[], transition?: number, overlay?: boolean, overlayOpacity?: number, format?: string, quality?: number): Promise<Uint8Array> {
	if (path.length == 0) {
		throw new Error('tui-image: path is empty')
	}
	let dir = 'vertical'
	if (direction != null) {
		dir = direction
	}
	let r1 = 0.2
	let r2 = 0.6
	let r3 = 0.2
	if (regions != null && regions.length >= 3) {
		r1 = regions[0]
		r2 = regions[1]
		r3 = regions[2]
	}
	let trans = 0.1
	if (transition != null) {
		trans = transition
	}
	let ov = false
	if (overlay != null) {
		ov = overlay
	}
	let ovOpacity = 0.4
	if (overlayOpacity != null) {
		ovOpacity = overlayOpacity
	}
	let fmt = 'png'
	let q = 85
	if (format != null) {
		fmt = format
	}
	if (quality != null) {
		q = quality
	}
	const bytes = await readImageBytes(path)
	try {
		const lib = await uni.loadUasm('uni_modules/tui-image-uasm')
		return lib.edgeBlur(bytes, radius, dir, r1, r2, r3, trans, ov, ovOpacity, fmt, q) as Uint8Array
	} catch (e) {
		console.log(e)
		throw new Error('tui-image: edgeBlur failed')
	}
}

export async function progressiveBlur(path: string, direction: string, radius: number, offset?: number, interpolation?: number, format?: string, quality?: number): Promise<Uint8Array> {
	if (path.length == 0) {
