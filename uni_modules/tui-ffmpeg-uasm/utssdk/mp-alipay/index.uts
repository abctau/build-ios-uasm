import { type MediaInfo } from '../interface.uts'

/**
 * App/小程序端实现：getMediaInfo 网络媒体优先 Range 拉头部快速解析，
 * 失败回退 downloadFile 全量；extractFrame 始终全量。
 */

function downloadToTemp(url: string): Promise<string> {
	return new Promise<string>((resolve, reject) => {
		uni.downloadFile({
			url: url,
			success: (res) => {
				if (res.statusCode == 200) {
					resolve(res.tempFilePath)
				} else {
					reject(new Error('tui-ffmpeg: download failed ' + res.statusCode + ' for ' + url))
				}
			},
			fail: (err) => {
				reject(new Error('tui-ffmpeg: download failed: ' + err.errMsg))
			}
		})
	})
}

function readLocalBytes(filePath: string): Promise<ArrayBuffer> {
	return new Promise<ArrayBuffer>((resolve, reject) => {
		uni.getFileSystemManager().readFile({
			filePath: filePath,
			success: (res) => {
				resolve(res.data as ArrayBuffer)
			},
			fail: (err) => {
				reject(new Error('tui-ffmpeg: read failed: ' + err.errMsg))
			}
		})
	})
}

async function readBytes(path: string): Promise<Uint8Array> {
	if (path.startsWith('http://') || path.startsWith('https://')) {
		const tmp = await downloadToTemp(path)
		return new Uint8Array(await readLocalBytes(tmp))
	}
	return new Uint8Array(await readLocalBytes(path))
}

function requestRangeBytes(url : string) : Promise<RangeFetchResult | null> {
	const header = new Map<string, string>()
	header.set('Range', 'bytes=0-524287')
	return new Promise<RangeFetchResult | null>((resolve) => {
		uni.request({
			url: url,
			header: header,
			responseType: 'arraybuffer',
			success: (res) => {
				if (res.statusCode == 206 || res.statusCode == 200) {
					const r : RangeFetchResult = {
						bytes: new Uint8Array(res.data as ArrayBuffer),
						isFull: res.statusCode == 200
					}
					resolve(r)
				} else {
					resolve(null)
				}
			},
			fail: () => {
				resolve(null)
			}
		})
	})
}

interface RangeFetchResult {
	bytes : Uint8Array
	isFull : boolean
}

/**
 * 网络媒体先尝试 Range 只拉头部（moov 在头部时可免全量下载解析出时长）；
 * 解析失败（moov 在尾部等）回退全量下载。
 */
export async function getMediaInfo(path : string) : Promise<MediaInfo> {
	if (path.length == 0) {
		throw new Error('tui-ffmpeg: path is empty')
	}
	if (path.startsWith('http://') || path.startsWith('https://')) {
		const r = await requestRangeBytes(path)
		if (r != null) {
			try {
				const lib = await uni.loadUasm('uni_modules/tui-ffmpeg-uasm')
				const json = lib.getMediaInfo(r.bytes) as string
				return JSON.parse(json) as MediaInfo
			} catch (e) {
				console.log(e)
				if (r.isFull) {
					throw new Error('tui-ffmpeg: getMediaInfo failed')
				}
			}
		}
	}
	const bytes = await readBytes(path)
	const lib = await uni.loadUasm('uni_modules/tui-ffmpeg-uasm')
	const json = lib.getMediaInfo(bytes) as string
	return JSON.parse(json) as MediaInfo
}

/**
 * 抽取 timeMs 附近（向后取关键帧）的视频帧，编码为 PNG。
 * maxWidth > 0 时等比缩放到该宽度；<= 0 保持原始尺寸。
 * 注意：解码需完整数据，网络视频会全量下载。
 */
export async function extractFrame(path : string, timeMs : number, maxWidth : number) : Promise<Uint8Array> {
	if (path.length == 0) {
		throw new Error('tui-ffmpeg: path is empty')
	}
	const bytes = await readBytes(path)
	const lib = await uni.loadUasm('uni_modules/tui-ffmpeg-uasm')
	return lib.extractFrame(bytes, timeMs, maxWidth) as Uint8Array
}


// ---------- B 方案转码：小程序端不支持（保留解析+抽帧） ----------

function unsupported(name : string) : Promise<boolean> {
	return new Promise<boolean>((resolve, reject) => {
		reject(new Error('tui-ffmpeg: ' + name + ' is not supported on mini-program (native transcode requires App or Web)'))
	})
}

export function videoMerge(videoPath : string, videoPath2 : string, outputPath : string) : Promise<boolean> {
	return unsupported('videoMerge')
}

export function durationClip(videoPath : string, startMs : number, durationMs : number, outputPath : string) : Promise<boolean> {
	return unsupported('durationClip')
}

